{
    "editor.fontFamily": "'CaskaydiaMono Nerd Font'",
    "editor.fontSize": 14,
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.bracketPairColorization.enabled": true,
    "editor.fontLigatures": true,
    "editor.linkedEditing": true,
    "editor.snippetSuggestions": "top",
    "editor.formatOnSave": true,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.fontVariations": false,
    "editor.detectIndentation": false,
    "security.workspace.trust.enabled": false,
    "emmet.preferences": {},
    "editor.quickSuggestions": {
        "comments": "on",
        "strings": "inline",
    },
    "terminal.integrated.enableVisualBell": true,
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
    },
    "emmet.triggerExpansionOnTab": true,
    "files.autoSave": "onFocusChange",
    "files.associations": {
        "*.css": "tailwindcss",
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": true,
        "markdown": true,
        "scminput": true,
    },
    "java.format.settings.url": "https://raw.githubusercontent.com/redhat-developer/vscode-java/refs/heads/main/formatters/eclipse-formatter.xml",
    "java.format.settings.profile": "GoogleStyle",
    "prettier.tabWidth": 4,
    "breadcrumbs.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "right",
    "workbench.editor.showTabs": "none",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.statusBar.visible": true,
    "github.copilot.nextEditSuggestions.enabled": false,
    "workbench.colorTheme": "Tokyo Night",
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
    },
    "[bash]": {
        "editor.defaultFormatter": "foxundermoon.shell-format",
    },
    "redhat.telemetry.enabled": false,
    "git.confirmSync": false,
    "chat.tools.terminal.autoApprove": {
        "mvn clean": true,
    },
    "terminal.integrated.initialHint": false,
    "git.openRepositoryInParentFolders": "always",
    "[dockercompose]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "chat.viewSessions.orientation": "stacked",
    "markdown.marp.html": "all",
    "explorer.confirmPasteNative": false,
    "claudeCode.preferredLocation": "panel",
    "copilot-pacer.username": "firo1919",
    "claudeCode.allowDangerouslySkipPermissions": true,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml",
    ],
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "diffEditor.ignoreTrimWhitespace": false,
}
