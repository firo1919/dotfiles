{
  "auto_update_extensions": {
    "java": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "selections_menu": false,
    "quick_actions": false,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "scrollbar": {
    "show": "never",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "features": {
    "edit_prediction_provider": "copilot",
  },
  "wrap_guides": [100],
  "show_wrap_guides": true,
  "hide_mouse": "on_typing_and_movement",
  "preferred_line_length": 100,
  "soft_wrap": "preferred_line_length",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "CaskaydiaMono Nerd Font",
  "ui_font_family": "CaskaydiaMono Nerd Font",
  "git":{
    "git_gutter":"tracked_files",
    "inline_blame":{
      "enabled": true
    }
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
  },
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night",
  },
}
